# ═══════════════════════════════════════════════════════════════════
# Orion — Environment Configuration
# Copy this file to .env and fill in your API keys.
# ═══════════════════════════════════════════════════════════════════

# ── LiveKit (Voice streaming) ─────────────────────────────────────
# Get credentials from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── STT Provider ──────────────────────────────────────────────────
# Options: "whisper_local" | "whisper" | "sarvam" | "deepgram" | "groq"
# "whisper_local" is free and needs no API key — see "Local speech servers" below.
STT_PROVIDER=whisper_local

# ── LLM Provider ──────────────────────────────────────────────────
# Options: "gemini" | "openai" | "claude" | "groq" | "ollama"
# Aliases accepted: "chatgpt"->openai, "anthropic"->claude, "google"->gemini,
#                   "local"->ollama
#
#   gemini  — free tier, needs GOOGLE_API_KEY
#   openai  — paid, needs OPENAI_API_KEY
#   claude  — paid, needs ANTHROPIC_API_KEY
#   groq    — free tier, needs GROQ_API_KEY
#   ollama  — FREE and fully local, no key (ollama pull qwen2.5:7b)
LLM_PROVIDER=gemini

# Override the model without editing the provider registry, e.g.
#   ORION_LLM_MODEL=claude-opus-5
#   ORION_LLM_MODEL=llama3.1:8b
# ORION_LLM_MODEL=

# Ollama endpoint (only used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434/v1

# ── TTS Provider ──────────────────────────────────────────────────
# Options: "kokoro" | "elevenlabs" | "openai" | "sarvam"
# "kokoro" is free and needs no API key — see "Local speech servers" below.
TTS_PROVIDER=kokoro

# ── Local speech servers (free, no API keys) ──────────────────────
# Both are OpenAI-compatible HTTP servers you run yourself on this machine.
#
# Whisper STT — e.g. whisper.cpp (Metal-accelerated on Apple Silicon):
#   ./build/bin/whisper-server -m models/ggml-large-v3-turbo.bin --port 8080
WHISPER_LOCAL_URL=http://127.0.0.1:8080/v1
WHISPER_LOCAL_MODEL=whisper-large-v3-turbo
#
# Kokoro TTS — e.g. kokoro-fastapi:
#   docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu
# Voices: am_michael / am_adam (US male), bm_george (UK male), af_heart (US female)
KOKORO_URL=http://127.0.0.1:8880/v1
KOKORO_VOICE=am_michael

# ── API Keys ──────────────────────────────────────────────────────
# OpenAI (for Whisper STT and/or OpenAI TTS)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# Google (for Gemini LLM)
GOOGLE_API_KEY=your-google-api-key

# Groq (for Groq Whisper STT and/or Groq Llama LLM)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Anthropic (for Claude LLM)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ElevenLabs (for TTS)
ELEVEN_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Sarvam AI (for Sarvam STT/TTS)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxx

# Deepgram (for Deepgram STT)
DEEPGRAM_API_KEY=your-deepgram-key

# ── OpenClaw Bridge ───────────────────────────────────────────────
# OpenClaw gateway URL (default port: 18789)
OPENCLAW_API_URL=http://127.0.0.1:18789
# Bearer token for OpenClaw gateway auth
OPENCLAW_GATEWAY_TOKEN=your-openclaw-token

# ── Orion Persona ────────────────────────────────────────────────
# How Orion addresses you (default: "sir")
ORION_USER_NAME=sir
# Optional wake word (not yet implemented)
ORION_WAKE_WORD=orion
